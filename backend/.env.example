PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Remote MySQL / TiDB Cloud Database Credentials
# For TiDB Cloud Serverless:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_cluster_user.root
# DB_PASSWORD=your_cluster_password
# DB_NAME=two_trade_db
# DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=two_trade_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Frontend URL for CORS and referral links
FRONTEND_URL=https://your-project.vercel.app

# Application Logic
OTP_EXPIRY_MINUTES=5
ALLOW_MULTIPLE_ACTIVE_PLANS=true
